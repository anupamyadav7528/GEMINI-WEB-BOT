{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat.js"
    },
    {
      "source": "/api/chat/clear",
      "destination": "/api/chat-clear.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}